# Cadence — environment variables
# Copy to .env.local and fill in. Never commit .env.local.

# Google Gemini API key. Server-only: read exclusively inside app/api route
# handlers. Never prefix with NEXT_PUBLIC_ — that would ship it to the browser.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Vercel Blob read/write token. Needed for direct client uploads of audio
# files (Phase 2+). Created automatically when you attach a Blob store to the
# project on Vercel; pull it locally with `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=
